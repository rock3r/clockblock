<?xml version="1.0" encoding="utf-8"?>
<!-- Classic RemoteViews Two Clocks, 4x2 / 4x3: dial beside the now card, Done on the right; 4x3 adds Up next and the
     adaptation bar below. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_fill" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- 4x3 only: "Tokyo · Day 2" with the trip's route in dot matrix at the end (the card then drops its header). -->
        <FrameLayout
            android:id="@+id/header_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/strip_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/strip_route"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Opens the plan. Done is a sibling, never a child, so each tap has exactly one target. -->
            <LinearLayout
                android:id="@+id/main"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/dial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_dial_placeholder" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextClock
                            android:id="@+id/local_clock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="h:mm"
                            android:format24Hour="HH:mm"
                            android:textColor="@color/widget_on_surface"
                            android:textSize="24sp" />

                        <TextClock
                            android:id="@+id/body_clock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="h:mm"
                            android:format24Hour="HH:mm"
                            android:textColor="@color/widget_on_surface_variant"
                            android:textSize="12sp"
                            android:textStyle="italic"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/misalignment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/widget_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                </FrameLayout>

                <include
                    android:id="@+id/card"
                    layout="@layout/widget_now_card_legacy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1.15" />
            </LinearLayout>

            <include
                android:id="@+id/done"
                layout="@layout/widget_done_legacy"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <include
            android:id="@+id/up_next"
            layout="@layout/widget_up_next_legacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
