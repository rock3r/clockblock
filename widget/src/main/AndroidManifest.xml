<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Instantiated by metrox-android's MetroAppComponentFactory (constructor injection). -->
        <receiver
            android:name=".TwoClocksWidgetProvider"
            android:exported="false"
            android:label="@string/widget_two_clocks_label"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_two_clocks_info" />
        </receiver>

        <receiver
            android:name=".NextUpWidgetProvider"
            android:exported="false"
            android:label="@string/widget_next_up_label"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_up_info" />
        </receiver>

        <!--
            Per-widget options (#52). Exported because the launcher starts it (Reconfigure); it checks that the widget
            id is one of ours before showing anything. Instantiated by metrox-android's MetroAppComponentFactory.
        -->
        <activity
            android:name=".config.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/widget_config_title"
            android:taskAffinity=""
            android:theme="@style/Theme.Clockblock.WidgetConfig"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
