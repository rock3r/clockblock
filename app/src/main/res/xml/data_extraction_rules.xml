<?xml version="1.0" encoding="utf-8"?>
<!--
    What Android backup (cloud-backup) and phone-to-phone transfer (device-transfer) copy. Each section is an
    include list: anything not listed stays on the device. BackupRulesTest checks these paths against the real
    store names, so update both together.

    Included (user data):
      - every DataStore document in filesDir/datastore (StoreFiles): profile, trips, settings, advice logs, and
        widget options. Widget ids are remapped when the launcher restores the widgets (WidgetProvider.onRestored).
      - opus_plan_celebrations: celebrations that already played for those trips, so they don't play again.
    Left out (device-specific or regenerable):
      - opus_notifications_snooze: a running snooze, tied to this device's alarms and expiring in minutes.
      - opus_widgets: this device's widget render configuration and published picker previews.
      - notifications_handled_alarms: the alarm instants already handled on this device (HandledAlarms).
      - datastore/*.corrupt-* copies, caches, and anything else. Plans are never stored (computed on demand), and
        alarms are re-armed when the app process starts after a restore (AdviceAlarmScheduler.start).
    Cloud backups are made on any device, even without a screen lock (so not always end-to-end encrypted): none of
    this is secret, and a backup beats losing your trips.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <include domain="file" path="datastore/profile.json" />
        <include domain="file" path="datastore/trips.json" />
        <include domain="file" path="datastore/settings.json" />
        <include domain="file" path="datastore/advice_logs.json" />
        <include domain="file" path="datastore/widget_configs.json" />
        <include domain="sharedpref" path="opus_plan_celebrations.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/profile.json" />
        <include domain="file" path="datastore/trips.json" />
        <include domain="file" path="datastore/settings.json" />
        <include domain="file" path="datastore/advice_logs.json" />
        <include domain="file" path="datastore/widget_configs.json" />
        <include domain="sharedpref" path="opus_plan_celebrations.xml" />
    </device-transfer>
</data-extraction-rules>
