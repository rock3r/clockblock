    <!-- Short instructions. Voice: precise, kind, occasionally dry (design.md §2.6). -->
    <string name="advice_instruction_see_bright_light">Outside is best. A window seat counts.</string>
    <string name="advice_instruction_see_light">Stay out of the dark. Lights on, no sunglasses.</string>
    <string name="advice_instruction_avoid_light">Sunglasses on, even if it feels silly. Especially if it feels silly.</string>
    <string name="advice_instruction_sleep">Cool, dark and quiet. If sleep won\'t come, just stay in the dark.</string>
    <string name="advice_instruction_nap">Keep it short and set an alarm.</string>
    <string name="advice_instruction_optional_nap">Only if you need it. Twenty minutes is plenty.</string>
    <string name="advice_instruction_melatonin">The type and dose you chose. No driving afterwards.</string>
    <string name="advice_instruction_caffeine">Little and often beats one big cup.</string>
    <string name="advice_instruction_avoid_caffeine">It would still be with you at bedtime.</string>
    <string name="advice_instruction_peak_fatigue">Your body\'s low point. Take extra care, especially driving.</string>
    <string name="advice_instruction_flight">Follow the light and sleep cards on board.</string>

