<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runtime permission on API 33+; requested from the UI via NotificationPermissions. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live Update (promoted ongoing) on travel day, API 36+. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Not USE_EXACT_ALARM: Play restricts that to alarm-clock/calendar apps. Revocable; we fall back to setWindow. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!--
            Receivers are constructor-injected by metrox-android's MetroAppComponentFactory
            (@BroadcastReceiverKey contributions), hence no default constructors.
        -->
        <receiver
            android:name=".receiver.AdviceAlarmReceiver"
            android:exported="false"
            tools:ignore="Instantiatable" />

        <receiver
            android:name=".receiver.AdviceActionReceiver"
            android:exported="false"
            tools:ignore="Instantiatable" />

        <!-- Exported only so the system can deliver these protected broadcasts; handling is idempotent. -->
        <receiver
            android:name=".receiver.ScheduleResetReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
