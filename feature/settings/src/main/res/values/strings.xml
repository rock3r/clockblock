    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_app_name">Clockblock</string>
    <string name="about_tagline">A jet lag planner that lives entirely on your phone. Free, open source, no account.</string>
    <string name="about_version">Version</string>
    <string name="about_version_unknown">Development build</string>
    <plurals name="about_taps_away">
        <item quantity="one">You are %1$d tap away from a concert.</item>
