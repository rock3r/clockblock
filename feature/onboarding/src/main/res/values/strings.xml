    <!-- 1. Welcome. -->
    <string name="welcome_kicker">Clockblock</string>
    <string name="welcome_headline">Jet lag is two clocks disagreeing.</string>
    <string name="welcome_body">We help your body clock catch up with the one on the wall: light, sleep and caffeine, timed to the minute.</string>
    <string name="welcome_badge_offline">Works offline</string>
    <string name="welcome_badge_free">Free and open source</string>
    <string name="welcome_badge_private">No account</string>
    <string name="welcome_disclaimer">General information, not medical advice. For healthy adults; not for flight crew on duty.</string>
    <string name="welcome_disclaimer_short">Not medical advice</string>
    <string name="welcome_disclaimer_show">Show the full disclaimer</string>
    <string name="welcome_disclaimer_hide">Hide the full disclaimer</string>
    <string name="welcome_get_started">Get started</string>
    <string name="welcome_art_description">Two clocks, a sun and a moon, sliding into line</string>

    <!-- 2. Home time zone. -->
    <string name="home_headline">Where\'s home?</string>
    <string name="home_body">We picked your phone\'s time zone; change it if you live somewhere else. A trip that leaves from another city can then start on home time.</string>
    <string name="home_current_label">Home time zone</string>
    <string name="home_device_chip">Phone\'s time zone</string>
    <string name="home_use_device">Use phone\'s time zone</string>
    <string name="home_search_label">Search a city or airport</string>
    <string name="home_search_clear">Clear search</string>
    <!-- The arrow that leaves the full-height search (field at the top, keyboard up) and goes back to the step. -->
    <string name="home_search_close">Close search</string>
    <!-- Above the results; a polite live region, so TalkBack reads how many places matched as you type. -->
    <plurals name="home_results_count">
        <item quantity="one">%1$d place matches</item>
        <item quantity="other">%1$d places match</item>
    </plurals>
    <string name="home_no_results">Nothing matches \u201c%1$s\u201d. Try a city or a three-letter airport code.</string>
    <string name="home_local_time">%1$s now · %2$s</string>

    <!-- 3. Sleep. -->
    <string name="sleep_headline">When do you usually sleep?</string>
    <string name="sleep_body">Drag the moon and the sun. Days off are when you wake without an alarm.</string>
    <string name="sleep_work_days">Work days</string>
    <string name="sleep_days_off">Days off</string>
