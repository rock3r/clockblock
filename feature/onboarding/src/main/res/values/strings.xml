    <string name="sleep_midnight">Midnight</string>
    <string name="sleep_hint_short">That\'s a short night. The plan works best with your real, usual sleep.</string>
    <string name="sleep_hint_long">That\'s a lot of sleep. Lucky you.</string>
    <string name="sleep_hint_linked">Same as work days until you move a handle.</string>
    <string name="sleep_egg_time">24:12</string>
    <string name="sleep_egg_caption">your body\'s day</string>
    <string name="sleep_egg_line">Your body\'s day is about 24.2 hours (Czeisler 1999). That\'s why flying west feels easier.</string>

    <!-- 3b. The chronotype worked out from the two usual nights (part of step 3 in the count). -->
    <string name="chronotype_reveal_kicker">Your chronotype</string>
    <string name="chronotype_reveal_kicker_picked">Your pick</string>
    <string name="chronotype_reveal_midpoint">Allowing for catch-up sleep, your nights off are centred on %1$s.</string>
    <string name="chronotype_reveal_midpoint_linked">Your usual nights are centred on %1$s. Set your days off on the previous step for a closer estimate.</string>
    <string name="chronotype_reveal_plan">Your plans start from your work-day sleep and this rhythm. You can change both in Settings.</string>
    <string name="chronotype_reveal_other">Doesn\'t sound like me</string>
    <string name="chronotype_sheet_title">Which sounds more like you?</string>
    <string name="chronotype_suggested">What your sleep suggests</string>
    <string name="chronotype_definite_morning">Early bird</string>
    <string name="chronotype_definite_morning_description">Up with the sun, fading by 10\u00A0pm.</string>
    <string name="chronotype_moderate_morning">Morning person</string>
    <string name="chronotype_moderate_morning_description">Mornings are your best hours.</string>
    <string name="chronotype_intermediate">Somewhere in between</string>
    <string name="chronotype_intermediate_description">Neither a lark nor an owl. Most people are here.</string>
    <string name="chronotype_moderate_evening">Evening person</string>
    <string name="chronotype_moderate_evening_description">Slow mornings, sharp evenings.</string>
    <string name="chronotype_definite_evening">Night owl</string>
    <string name="chronotype_definite_evening_description">Midnight is early. Alarms are the enemy.</string>

    <!-- 4. Tools / Preferences. -->
    <string name="tools_headline">Your tools</string>
    <string name="tools_body">Pick what you\'re happy to use. You can change any of this later in Settings.</string>
    <string name="tool_caffeine">I drink caffeine</string>
    <string name="tool_caffeine_description">Little-and-often coffee to stay sharp, and a cut-off before sleep. If you don\'t drink it, no need to start now.</string>
    <string name="tool_planes">I can sleep on planes</string>
    <string name="tool_planes_description">Off means in-flight sleep becomes rest in the dark.</string>
    <string name="tool_naps">Naps are OK</string>
    <string name="tool_naps_description">Adds optional short naps for when you might be tired. A nap after an extra-long day stays either way.</string>
    <string name="tool_head_start">Head start</string>
    <string name="tool_head_start_description">Shift a little on the days before departure, so you land partly adapted.</string>
    <string name="tool_head_start_none">None</string>
    <string name="tool_head_start_gentle_cap">Gentle effort uses at most %1$d days.</string>
    <plurals name="tool_head_start_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <string name="tool_melatonin">I use melatonin</string>
    <string name="tool_melatonin_description">Off by default. Read the safety note to switch it on.</string>
    <string name="tool_melatonin_on_description">A low dose at a precise time, only when it helps shift you earlier.</string>
    <string name="melatonin_note_title">Before you use melatonin</string>
    <string name="melatonin_note_show">Read the safety note</string>
    <string name="melatonin_note_hide">Hide the safety note</string>
    <string name="melatonin_note_dose">The plan suggests 0.5 mg of fast-release melatonin. More is not better.</string>
    <string name="melatonin_note_doctor">Check with a doctor or pharmacist first, especially if you are pregnant or breastfeeding, have epilepsy or an autoimmune condition, or take blood thinners, fluvoxamine or immunosuppressants.</string>
    <string name="melatonin_note_driving">Don\'t drive or operate machinery for several hours after taking it.</string>
    <string name="melatonin_note_legal">Rules differ by country: over the counter in the US, prescription-only in the UK and Australia, not approved in Japan.</string>
    <string name="melatonin_note_ack">I\'ve read this and I\'ll check what applies to me</string>
    <string name="effort_title">How hard should the plan push?</string>
    <string name="effort_gentle">Gentle</string>
    <string name="effort_balanced">Balanced</string>
    <string name="effort_max">Max</string>
    <string name="effort_gentle_description">Smaller daily shifts and fewer early starts. Takes a little longer.</string>
    <string name="effort_balanced_description">The research-backed pace. A good default for most trips.</string>
    <string name="effort_max_description">The Balanced pace. For eastward shifts of 8 to 12 hours, it tries both directions on the model and switches if the other one is more than a day faster.</string>

    <!-- 5. Reminders. -->
    <string name="reminders_headline">Reminders that actually arrive</string>
    <string name="reminders_body">One quiet nudge before each change, timed to the minute. Never while you\'re meant to be asleep, except to wake you.</string>
    <string name="reminders_preview_description">A sample reminder: See bright light, with how long is left and what comes next.</string>
    <string name="reminders_preview_caption">A sample. Yours follow your own plan.</string>
